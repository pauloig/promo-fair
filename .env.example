# ===== Backend (apps/api) =====

# Cadena de conexión a PostgreSQL (Prisma).
# En Docker el host de la base es "db"; en local, "localhost".
DATABASE_URL=postgresql://disagro:disagro@localhost:5432/disagro

# Secreto para firmar las sesiones JWT (cliente y Ventas).
JWT_SECRET=cambia-este-secreto

# Credenciales del panel de Ventas.
VENTAS_USERNAME=ventas
VENTAS_PASSWORD=cambia-esta-contrasena

# ===== Frontend (apps/web) =====

# URL base de la API consumida por el frontend.
# - Dev sin Docker (vite .env): http://localhost:3000/api
# - Build Docker (argo del web): /api (misma-origen a través del proxy Nginx)
VITE_API_URL=/api