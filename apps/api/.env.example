# Cadena de conexión a PostgreSQL (Prisma).
# En Docker el host de la base es "db"; en local, "localhost".
DATABASE_URL="postgresql://disagro:disagro@localhost:5432/disagro"

# Secreto para firmar las sesiones JWT de cliente (ver ADR-003).
JWT_SECRET=cambia-este-secreto

# Credenciales del panel de Ventas (usa el seed de Prisma para crear el usuario).
VENTAS_USERNAME=ventas
VENTAS_PASSWORD=cambia-esta-contrasena

# Rango de fecha/hora del evento (ISO 8601). Ver ADR-010.
# El backend falla al arrancar si alguna de estas variables no está definida.
EVENTO_FECHA_INICIO="2026-11-21T08:00:00-06:00"
EVENTO_FECHA_FIN="2026-11-22T18:00:00-06:00"

# Atributo Secure de las cookies de sesión y CSRF (ADR-003/ADR-012).
# Default: true en producción (NODE_ENV=production), false en desarrollo.
# Se puede forzar explícitamente con "true"/"false".
#COOKIE_SECURE="true"

# Dominio (atributo Domain) de las cookies. Ver ADR-003.
# Default: sin dominio (cookie host-only, válida solo para el host exacto).
# Como web y API comparten el mismo dominio en producción (mismo origen vía Nginx),
# no hace falta fijarlo; se deja documentado por si se separaran a subdominios.
#COOKIE_DOMAIN=".endtoendsolutions.dev"

# Orígenes permitidos para CORS con credenciales (separados por coma). Ver ADR-003/ADR-004.
# Default: vacío en producción (frontend y API en el mismo origen, sin CORS necesario);
# en desarrollo, http://localhost:5173 y http://127.0.0.1:5173 (Vite).
#CORS_ORIGINS="https://disagro.endtoendsolutions.dev"