# ===== Backend (apps/api) =====

# Cadena de conexión a PostgreSQL (Prisma).
# En Docker el host de la base es "db"; en local, "localhost".
DATABASE_URL=postgresql://disagro:disagro@localhost:5432/disagro

# Secreto para firmar las sesiones JWT (cliente y Ventas).
JWT_SECRET=cambia-este-secreto

# Credenciales del panel de Ventas.
VENTAS_USERNAME=ventas
VENTAS_PASSWORD=cambia-esta-contrasena

# Rango de fecha/hora del evento en formato ISO 8601 (ADR-010).
# Configurables por entorno (backend); la API los expone vía GET /api/evento/rango-fecha.
# El backend falla al arrancar si alguna de estas variables no está definida.
EVENTO_FECHA_INICIO=2026-11-21T08:00:00-06:00
EVENTO_FECHA_FIN=2026-11-22T18:00:00-06:00

# ===== Frontend (apps/web) =====

# URL base de la API consumida por el frontend.
# - Dev sin Docker (vite .env): http://localhost:3000/api
# - Build Docker (argo del web): /api (misma-origen a través del proxy Nginx)
VITE_API_URL=/api

# ===== Producción (docker-compose.prod.yml) =====
#
# NO reutilices el .env de desarrollo al desplegar: en producción la base
# vive en la red interna de Docker y el host NO es "localhost".
# Copia estas claves a un .env dedicado (p. ej. .env.prod) y súbelo al
# servidor junto con docker-compose.prod.yml.

# Correo del titular de la cuenta de Let's Encrypt (emisión del certificado).
LETSENCRYPT_EMAIL=paulo.ismalej@gmail.com

# Credenciales de la base en producción (mismo formato para POSTGRES_USER y POSTGRES_DB).
# El API en producción debe apuntar al servicio "db" de la red interna:
#   DATABASE_URL=postgresql://disagro:disagro@db:5432/disagro
POSTGRES_PASSWORD=cambia-esto-en-produccion